          "name": "Envoy Proxy Drain Listeners",
          "request": {
            "name": "Envoy Proxy Drain Listeners",
            "description": {
              "content": "Drains all listeners, causing them to stop accepting new connections. Existing connections are allowed to complete.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "drain_listeners"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "graceful",
                  "value": "<boolean>",
                  "description": "When set, listeners are drained gracefully with a period where both old and new listeners accept connections."
                },
                {
                  "disabled": false,
                  "key": "inboundonly",
                  "value": "<boolean>",
                  "description": "Drain only inbound listeners and leave outbound listeners intact."
                }
              ],
              "variable": []
