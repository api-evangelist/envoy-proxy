          "name": "Envoy Proxy Get Statistics",
          "request": {
            "name": "Envoy Proxy Get Statistics",
            "description": {
              "content": "Returns statistics that Envoy has collected, including counters, gauges, and histograms. Stats are provided as key-value pairs using a hierarchical dotted notation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stats"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Output format for the statistics."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Regular expression to filter the returned statistics by name."
                },
                {
                  "disabled": false,
                  "key": "usedonly",
                  "value": "<boolean>",
                  "description": "Only return statistics that have been written to by Envoy."
                },
                {
                  "disabled": false,
                  "key": "histogram_buckets",
