          "name": "Envoy Proxy View or Modify Log Levels",
          "request": {
            "name": "Envoy Proxy View or Modify Log Levels",
            "description": {
              "content": "Enable or change logging levels at runtime. Without query parameters, returns the current logging levels. With a query parameter, sets the logging level for a specific logger or all loggers.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "logging"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "level",
                  "value": "<string>",
                  "description": "Set the log level for all loggers. Valid values include trace, debug, info, warning/warn, error, critical, and off."
                },
                {
                  "disabled": false,
                  "key": "paths",
                  "value": "<string>",
                  "description": "Set a glob pattern for file path to filter the log output."
                }
              ],
              "variable": []
            },
